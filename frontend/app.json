{
  "expo": {
    "name": "FridgeOut: Recipe Wizard",
    "slug": "fridgechef",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/fridgeout-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.libowen.fridgetofood"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/fridgeout-logo.png",
        "backgroundColor": "#FFF8E9"
      },
      "package": "com.libowen.fridgetofood"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/fridgeout-logo.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FridgeOut to recognize ingredients in your photos.",
          "cameraPermission": "Allow FridgeOut to photograph your ingredients.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/fridgeout-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF8E9"
        }
      ],
      "expo-font"
    ],
    "description": "Cook with what you have"
  }
}
